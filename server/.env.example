# Copy to .env and set your real Anthropic key
ANTHROPIC_API_KEY=sk-ant-api03-...your_key_here
# Optional: restrict browser origins. Must EXACTLY match the URL you load the
# app from — http://localhost:8080 and http://127.0.0.1:8080 are different
# origins. Use * for local dev if unsure.
ALLOWED_ORIGIN=*
# Optional: change the proxy listen port (3000 is taken by Grafana on this machine)
PROXY_PORT=8787
# Optional: override the remote target (defaults to Anthropic)
# TARGET_ENDPOINT=https://api.anthropic.com/v1/messages
# Optional: song BPM/key lookup for "Learn a song" (free key, backlink required)
# https://getsongbpm.com/api — also set this in Netlify's environment variables
GETSONGBPM_API_KEY=
