@@ -0,0 +1,72 @@
+/* ============================================================
+   tools.css — progression tools strip, Hooktheory dialog bits,
+   MIDI-in rail card, speed trainer.
+   ============================================================ */
+
+/* ---- progression tools strip (under guitar / piano output) ---- */
+.prog-tools{display:flex;flex-direction:column;gap:6px;margin:0 0 12px}
+.prog-tools:empty{display:none}
+.pt-row{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;font-size:11px;color:var(--text)}
+.pt-k{color:var(--muted);letter-spacing:0.06em;text-transform:uppercase;font-size:10px;margin-left:4px}
+.pt-k:first-child{margin-left:0}
+.pt-dim{color:var(--muted)}
+.pt-motion,.pt-key{font-family:var(--mono);color:var(--accent)}
+.pt-key{min-width:2.4em;text-align:center}
+.pt-capo{font-family:var(--mono);color:var(--amber);margin-left:6px}
+.pt-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:999px;border:1px solid var(--border2);background:var(--surface2);font-family:var(--mono)}
+.pt-unusual{color:var(--coral);border-color:rgba(255,124,124,0.3)}
+.pt-uncommon{color:var(--amber);border-color:rgba(255,203,107,0.3)}
+.pt-familiar{color:var(--green);border-color:rgba(111,255,196,0.25)}
+.pt-very-common{color:var(--blue);border-color:rgba(124,212,255,0.3)}
+.pt-history{align-items:flex-start}
+.pt-hchips{display:flex;flex-wrap:wrap;gap:4px}
+.pt-hchip{display:inline-flex;border:1px solid var(--border);border-radius:6px;overflow:hidden;background:var(--surface)}
+.pt-hchip.on{border-color:var(--accent2);background:var(--surface3)}
+.pt-hchip.starred .pt-star{color:var(--amber)}
+.pt-hload,.pt-star{background:none;border:0;color:var(--text);font-family:var(--mono);font-size:10px;padding:3px 7px;cursor:pointer}
+.pt-star{color:var(--muted);border-left:1px solid var(--border);padding:3px 6px}
+.pt-hload:hover,.pt-star:hover{background:var(--surface2)}
+.prog-tools .pb-btn[disabled]{opacity:0.4;cursor:default}
+
+/* realism-mode select next to the skeleton toggle */
+.realism-mode{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--muted)}
+.realism-mode select{font-size:11px}
+.ht-off{opacity:0.5}
+.hbtn-user{color:var(--muted);font-size:10px;max-width:90px;overflow:hidden;text-overflow:ellipsis}
+
+/* ---- Hooktheory dialog ---- */
+#ht-form,#ht-connected{display:flex;flex-direction:column;gap:12px}
+.modal-status.ok{color:var(--green)}
+.modal-status.err{color:var(--coral)}
+.ht-report{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px;font-family:var(--mono);font-size:11px;line-height:1.5}
+.ht-report .ok{color:var(--green)}
+.ht-report .bad{color:var(--coral)}
+
+/* ---- MIDI in (rail card) ---- */
+.midi-device{float:right;color:var(--muted);font-size:10px;letter-spacing:0;text-transform:none;max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.midi-readout{display:flex;align-items:baseline;gap:10px;margin:2px 0 4px}
+.midi-chord{font-family:var(--display);font-size:26px;font-weight:700;color:var(--muted);line-height:1.1}
+.midi-chord.live{color:var(--accent)}
+.midi-degree{font-family:var(--mono);font-size:12px;color:var(--green)}
+.midi-notes{font-family:var(--mono);font-size:11px;color:var(--muted);margin-bottom:8px;min-height:15px}
+.midi-actions{display:flex;flex-wrap:wrap;gap:6px}
+.midi-actions .pb-btn[disabled]{opacity:0.4;cursor:default}
+.midi-opts{display:flex;gap:12px;margin-top:8px;font-size:11px;color:var(--muted)}
+.midi-opts label{display:inline-flex;align-items:center;gap:5px;cursor:pointer}
+.midi-status{font-size:11px;color:var(--accent);margin-top:6px;min-height:14px;line-height:1.5}
+
+/* ---- speed trainer (practice tab) ---- */
+.speed-trainer{margin-top:22px;padding-top:16px;border-top:1px solid var(--border)}
+.speed-grid{display:flex;flex-wrap:wrap;gap:10px 16px;margin:10px 0 12px}
+.speed-grid label{display:inline-flex;align-items:center;gap:6px;font-size:11px;color:var(--muted)}
+.speed-grid input[type=number]{width:58px;background:var(--surface2);border:1px solid var(--border2);border-radius:6px;color:var(--text);font-family:var(--mono);font-size:12px;padding:5px 6px}
+.speed-mini{background:none;border:1px solid var(--border);border-radius:6px;color:var(--muted);font-family:var(--mono);font-size:10px;padding:4px 6px;cursor:pointer}
+.speed-mini:hover{color:var(--text)}
+.speed-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
+.speed-readout{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;min-height:28px}
+.speed-bpm{font-family:var(--display);font-size:28px;font-weight:700;color:var(--accent);line-height:1}
+.speed-unit{font-size:10px;color:var(--muted);letter-spacing:0.08em}
+.speed-meta{font-size:12px;color:var(--muted)}
+.speed-bar{display:inline-block;width:120px;height:4px;border-radius:2px;background:var(--surface3);position:relative;overflow:hidden;align-self:center}
+.speed-bar::after{content:"";position:absolute;inset:0;width:var(--p,0%);background:var(--accent2);transition:width 0.3s}
+#ht-form,#ht-connected{margin-top:6px}
