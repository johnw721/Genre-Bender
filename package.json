{
  "name": "genre-bender",
  "version": "0.1.0",
  "private": true,
  "description": "Genre Bender — runs the static UI (port 5500) and the Anthropic proxy (port 8787) together with one command.",
  "scripts": {
    "start": "concurrently -k -n proxy,web -c magenta,cyan \"npm start --prefix server\" \"vite --port 5500 --open\"",
    "proxy": "npm start --prefix server",
    "web": "vite --port 5500 --open",
    "build:single": "node build/build-single-file.mjs",
    "verify:single": "node build/verify-single-file.mjs dist/genre-bender.html",
    "verify:clips": "node build/verify-clips.mjs",
    "share": "npm run build:single && npm run verify:single",
    "setup": "npm install && npm install --prefix server",
    "postinstall": "npm install --prefix server"
  },
  "devDependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tonal": "^6.4.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  }
}
